{
  // Budget Explorer. Separate Worker from the placeholder site.
  // D1 database budget-explorer. Migration 0001_init.sql is already applied remotely.
  // Apply migrations/0002_settings.sql remotely before deploying the names switch.
  // Apply migrations/0003_revenue_reserves.sql by hand. Do not run wrangler d1 migrations apply --remote.
  // Apply migrations/0004_county_requests.sql by hand. Do not run wrangler d1 migrations apply --remote.
  "name": "budget-explorer",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-27",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "budget-explorer",
      "database_id": "06dfc109-c0e5-4ce1-a87f-e7f1b4b2ef50"
    }
  ],
  "vars": {
    "PUBLIC_BASE_URL": ""
  }
}
