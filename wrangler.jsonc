{
  // Sandbox placeholder. Worker name is whatshappening.
  // Do not add a custom domain in this file. DNS stays unset on purpose.
  "name": "whatshappening",
  "main": "worker.js",
  "compatibility_date": "2026-09-29",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/dash", "/dash/*"]
  },
  // /dash is forwarded unchanged to the dashboard Worker. That Worker owns the prefix.
  "services": [{ "binding": "DASH", "service": "dashboard" }],
  // Required by `npx wrangler preview`. Keep this empty. Do not put secrets here.
  "previews": {}
}
